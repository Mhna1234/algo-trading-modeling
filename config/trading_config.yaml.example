# Trading Configuration File - EXAMPLE TEMPLATE
# ================================================
# This is a template file. Copy to trading_config.yaml and fill in your values.
# DO NOT commit your actual config file with API keys to version control!
#
# To use:
# 1. Copy this file: cp config/trading_config.yaml.example config/trading_config.yaml
# 2. Edit config/trading_config.yaml with your actual values
# 3. Set environment variables for API keys (recommended)

# Execution Mode
# ==============
# - backtest: Traditional batch backtesting
# - simulation: Historical date replay with state persistence
# - live: Real-time trading with daily updates
execution:
  mode: "simulation"  # Options: backtest, simulation, live

# Core Trading Parameters
# =======================
trading:
  initial_capital: 100000
  transaction_cost_bps: 10.0  # 0.1%
  slippage_bps: 1.0
  rebalance_frequency: "M"  # M=monthly, Q=quarterly, W=weekly
  enable_soft_rebalance: true
  drift_threshold: 0.05  # For soft rebalancing

# Data Configuration
# ==================
data:
  start_date: "2015-01-01"
  end_date: "2024-12-31"
  update_if_available: true  # Check for new S3 data on load
  data_dir: "data"
  processed_dir: "data/processed"
  raw_dir: "data/raw"

# Strategy Configuration
# ======================
strategies:
  use_bandit_wrapper: true
  include_risk_free: true  # Include risk-free asset as strategy option

  # Individual strategy parameters
  momentum:
    lookback: 126
    target_quintile: 5
  low_volatility:
    lookback: 126
    target_quintile: 1
  mean_reversion:
    lookback: 21
  gmvp:
    lookback: 252
    max_weight: 0.5
  inverse_volatility:
    lookback: 63
  risk_parity:
    lookback: 252
    max_weight: 0.4
  max_diversification:
    lookback: 252
    max_weight: 0.5
  max_decorrelation:
    lookback: 252
    max_weight: 0.5
  sharpe_maximization:
    lookback: 252
    max_weight: 0.3
  cvar_minimization:
    lookback: 252
    alpha: 0.95
    max_weight: 0.3

# Multi-Armed Bandit Configuration
# ================================
# Based on existing BANDIT_CONFIG pattern from demo_soft_rebalancing_walkforward.py
bandit:
  type: "ucb"  # Options: ucb, thompson, exp3
  exploration_constant: 2.0  # For UCB
  gamma: 0.07  # For EXP3
  burn_in_periods: 12  # Months before bandit starts learning
  reward_type: "sharpe"  # Options: sharpe, return, clipped_sharpe
  reward_lookback: 12  # Periods for reward calculation
  min_allocation: 0.05  # Minimum allocation per strategy
  enable_soft_allocation: true  # True=weighted average, False=hard allocation
  random_seed: 42

# Risk-Free Asset Configuration
# =============================
risk_free:
  rate_source: "fred"  # Options: fred, config, fallback
  maturity: "3M"  # Options: 1M, 3M, 6M, 1Y, 2Y, 5Y, 10Y, 30Y
  initial_rate: 0.04  # 4% fallback rate
  api_key_env_var: "FRED_API_KEY"  # Environment variable name
  update_frequency: "D"  # D=daily, W=weekly, M=monthly

# Checkpoint & Persistence
# ========================
checkpoint:
  enabled: true
  directory: "checkpoints"
  max_checkpoints: 7  # Auto-cleanup after 7 days
  use_parquet: true  # Use Parquet for time series data

# Results & Output
# ================
output:
  results_dir: "results"
  save_plots: true
  save_metrics: true
  log_level: "INFO"  # DEBUG, INFO, WARNING, ERROR
  log_file: "results/dynamic_trading_demo.log"

# Simulation Settings
# ===================
simulation:
  speed: 1.0  # 1.0 = real-time, 0.0 = instant replay
  pause_between_steps: 0.1  # Seconds between simulation steps

# Live Trading Settings
# ====================
live:
  data_update_interval: 3600  # Seconds between data checks (1 hour)
  max_retry_attempts: 3
  retry_delay: 60  # Seconds between retries
  health_check_interval: 300  # 5 minutes

# AWS S3 Configuration
# ====================
aws:
  bucket: "data-retrieval-output"
  region: "us-east-1"  # Default region
  access_key_env_var: "AWS_ACCESS_KEY_ID"
  secret_key_env_var: "AWS_SECRET_ACCESS_KEY"

# API Keys Configuration
# ======================
# IMPORTANT: Set these as environment variables, NOT in this file!
# The values below are placeholders that will be replaced by env vars.
api_keys:
  fred: "${FRED_API_KEY}"  # Will be replaced with environment variable
  aws_access_key: "${AWS_ACCESS_KEY_ID}"
  aws_secret_key: "${AWS_SECRET_ACCESS_KEY}"

# Performance Monitoring
# ======================
monitoring:
  enable_profiling: false
  memory_threshold_mb: 2048  # 2GB
  cpu_threshold_percent: 50
  log_performance_metrics: true

# Development & Testing
# =====================
development:
  enable_debug_mode: false
  skip_data_validation: false
  use_cached_data: true  # Use local cache instead of fresh downloads